# ==============================================================================
# Dev Den — Portfolio Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development or set these variables
# directly in your production hosting platform (e.g. Vercel, Railway, Cloud Run).
#
# IMPORTANT:
# - Server-only secrets MUST NEVER be prefixed with `NEXT_PUBLIC_`.
# - Only public variables accessible by browser JS use `NEXT_PUBLIC_`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MongoDB) — REQUIRED FOR FULL-STACK CMS
# ------------------------------------------------------------------------------
# Standard connection string for local instance or MongoDB Atlas cluster.
# For local development: "mongodb://127.0.0.1:27017/devden"
# For MongoDB Atlas: "mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/devden?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://admin_user:YourStrongPassword123@cluster0.abcde.mongodb.net/devden?retryWrites=true&w=majority"
MONGODB_DB="devden"

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security — REQUIRED
# ------------------------------------------------------------------------------
# AUTH_SECRET: Cryptographic HMAC key for signing secure HTTP-only session cookies.
# Generate a fresh 32+ character key using: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET="your_32_character_cryptographically_secure_random_secret_string_here"

# AUTH_URL: The canonical base URL of your deployed application.
# For local development: "http://localhost:3000"
# For production: "https://yourdomain.com"
AUTH_URL="http://localhost:3000"

# ADMIN_EMAIL: Admin user login email address.
ADMIN_EMAIL="admin@yourdomain.com"

# ADMIN_PASSWORD_HASH: Bcrypt hash of the admin password.
# To generate a hash for your password, run:
# node -e "console.log(require('bcryptjs').hashSync('YourSecurePasswordHere', 10))"
ADMIN_PASSWORD_HASH="$2b$10$ID9Nz3EliuQr3LspBB5Qiu21z/FdV5v0DBvodnp7N2qmyV9U68.5W"

# TEST_ADMIN_PASSWORD: Test suite password matching ADMIN_PASSWORD_HASH in CI environments.
TEST_ADMIN_PASSWORD="test-admin-ci-password-1234"

# ------------------------------------------------------------------------------
# 3. Media & Asset Storage (Cloudinary) — OPTIONAL (Recommended for uploads)
# ------------------------------------------------------------------------------
# Required for uploading custom project screenshots, identity portraits, and meme clips.
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_key"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# ------------------------------------------------------------------------------
# 4. Email Notification Service (Resend) — OPTIONAL
# ------------------------------------------------------------------------------
# Required for receiving real-time email dispatch notifications when a visitor submits the contact form.
# Get an API key from https://resend.com
RESEND_API_KEY="re_1234567890abcdefghijklmnopqrstuvwxyz"
# The verified sender email in your Resend account (e.g. "noreply@yourdomain.com" or "onboarding@resend.dev")
RESEND_FROM="inquiries@yourdomain.com"
# The inbox where contact form messages will be delivered
CONTACT_TO_EMAIL="hello@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. Public Site Configuration & Rate Limiting — REQUIRED
# ------------------------------------------------------------------------------
# Canonical production URL (used for OpenGraph preview tags, canonical meta, and sitemaps).
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Salt for anonymizing and hashing client IP addresses for rate limiting without storing PII.
# Generate with: `node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"`
IP_HASH_SALT="your_privacy_preserving_ip_hash_salt_string"
